                "group": "Nomo",
                "pages": [
                  "status",
                  "usage",
                  "sessions/overview",
                  "providers"
                ]
              }
            ]
          },
          {
            "tab": "Sessions",
            "groups": [
              {
                "group": "Setup",
                "icon": "wrench",
                "pages": [
                  "setup/install",
                  "setup/pairing"
                ]
              },
              {
                "group": "Using Sessions",
                "icon": "mobile-screen",
                "pages": [
