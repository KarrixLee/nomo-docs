{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Nomo",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/nomo-light.png",
    "dark": "/logo/nomo-dark.png"
  },
  "colors": {
    "primary": "#b06046",
    "light": "#E5A184",
    "dark": "#B85C3C"
  },
  "background": {
    "image": {
      "light": "/images/bg-light.svg",
      "dark": "/images/bg-dark.svg"
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/KarrixLee/nomo"
      }
    ]
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
